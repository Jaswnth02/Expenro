# Supabase Project URL & Anonymous Key (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: Supabase Service Role Key (Server-side administrative tasks only, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Future AI Financial Assistant (Server-side only)
# AI_API_KEY=your-gemini-or-openai-api-key
