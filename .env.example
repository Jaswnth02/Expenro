# ==============================================================================
# EXPENRO — Environment Variables Configuration
# Brand: EXPENRO (Track. Spend. Save.)
# ==============================================================================

# MongoDB Connection URI (Local instance or MongoDB Atlas cluster)
# Example Local: mongodb://localhost:27017/expenro
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/expenro?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/expenro

# JWT Auth Secret (generate with `openssl rand -base64 32` or any long random secret string)
AUTH_SECRET=expenro-secure-auth-jwt-secret-key-32chars-minimum!

# Base application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

